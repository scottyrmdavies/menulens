# Server-only. Do not put these in the Vite client or prefix them with VITE_.
# On Vercel, set them in Project Settings → Environment Variables.

# Required. Free key from Google AI Studio: https://aistudio.google.com/apikey
# No Google Cloud billing account is required for the free tier.
# The scan API calls gemini-4-hydrogen, which reads the menu photo itself.
GEMINI_API_KEY=

# Optional. Document Text Detection, used only as extra text next to the photo.
# Cloud Vision needs a Google Cloud billing account. Leave this blank for a free deploy.
GOOGLE_CLOUD_VISION_API_KEY=

# Optional. Local scan server port. Vite proxies /api to this port.
# Ignored on Vercel.
PORT=8787
