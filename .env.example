# Server-only. Do not put these in the Vite client or prefix them with VITE_.
# Google Cloud Vision API key used for Document Text Detection.
GOOGLE_CLOUD_VISION_API_KEY=

# Gemini API key. The scan server calls the model gemini-4-hydrogen.
GEMINI_API_KEY=

# Optional. Scan server port. Vite proxies /api to this port.
PORT=8787
