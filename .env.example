# Server-only. Do not put these in the Vite client or prefix them with VITE_.
# On Vercel, set them in Project Settings → Environment Variables.
# The app still runs when the optional ones are blank.

# Required for scans. Free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional paid key. When it is set, the scan races it against GEMINI_API_KEY
# and keeps whichever answer arrives first.
GEMINI_API_KEY_2=

# Optional OCR hint. Leave blank. Cloud Vision needs a Google Cloud billing account.
GOOGLE_CLOUD_VISION_API_KEY=

# Neon Postgres connection string (Vercel Neon integration). Emails, diets, scans, trials.
# If this is blank, email capture says it was not stored and scans stay open.
DATABASE_URL=

# Stripe. Leave all three blank to keep the app in free/trial mode.
# STRIPE_PRICE_ID should be a monthly price of $4 (about £3). The app does not set the amount.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Password for the /admin usage page. If blank, /admin says it is not configured.
ADMIN_PASSWORD=

# Local scan server port. Vite proxies /api to this port. Ignored on Vercel.
PORT=8787
